{
  "name": "bihon-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "A local manga, webtoon, and EPUB reader for Windows and Linux, with a native Android build",
  "author": "JzHamid",
  "license": "MPL-2.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:ui": "node scripts/build-ui.cjs",
    "verify:books": "node scripts/verify-books.cjs",
    "dist": "electron-builder --config electron-builder.cjs",
    "source": "node scripts/source-archive.cjs",
    "release": "node scripts/release.cjs",
    "bootstrap": "node scripts/bootstrap.cjs",
    "lint": "node scripts/check.cjs lint",
    "typecheck": "node scripts/check.cjs types",
    "check": "node scripts/check.cjs",
    "dist:windows": "electron-builder --config electron-builder.cjs --win nsis --x64",
    "dist:linux": "electron-builder --config electron-builder.cjs --linux AppImage deb --x64",
    "verify:packaged": "node scripts/verify-packaged.cjs",
    "android:prepare": "node scripts/android-prepare.cjs",
    "android:collect": "node scripts/android-collect.cjs",
    "android:source": "node scripts/android-source.cjs"
  },
  "devDependencies": {
    "agent-browser": "0.27.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "node": "24.20.0",
    "playwright": "1.63.0",
    "pnpm": "11.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
