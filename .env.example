# Desktop optional override; omit to use the normal per-user application data.
# BIHON_DATA_DIR=/absolute/path/to/isolated-bihon-data

# CI/native Android production signing. Never commit actual values or a keystore.
# Pass these as environment variables; the scripts do not load this file.
BIHON_ANDROID_RELEASE=false
BIHON_ANDROID_KEYSTORE_PATH=
BIHON_ANDROID_KEYSTORE_PASSWORD=
BIHON_ANDROID_KEY_ALIAS=
BIHON_ANDROID_KEY_PASSWORD=
# GitHub Actions stores the base64 keystore in BIHON_ANDROID_KEYSTORE_BASE64.
